# ---------------------------------------------------------------------------
# Copiar a .env y ajustar. NUNCA commitear el .env real.
# ---------------------------------------------------------------------------

# Base de datos ------------------------------------------------------------
# Unico acoplamiento con la base: apunta esta cadena a donde quieras (un
# contenedor, un Postgres nativo, Neon, RDS) sin tocar una linea de codigo.
#
# El driver DEBE ser asyncpg. Alembic deriva la version sincrona (psycopg)
# por su cuenta, asi que no hace falta una segunda cadena.
#
# Si vienes de Prisma, la traduccion tiene dos cambios obligatorios:
#   Prisma      postgresql://usuario:clave@localhost:5432/finance?schema=public
#   SQLAlchemy  postgresql+asyncpg://usuario:clave@localhost:5432/finance
#   1. "+asyncpg": sin el, SQLAlchemy intenta psycopg2 (sincrono) y no arranca.
#   2. sin "?schema=public": es exclusivo de Prisma; asyncpg lo pasaria como
#      opcion del servidor y la conexion falla. public ya es el search_path.
DATABASE_URL=postgresql+asyncpg://finance:finance_dev_password@localhost:5433/finance

# Seguridad ----------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambiar-esto-en-produccion-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie del refresh token.
# En dev queda vacio (host-only sobre localhost). En produccion: .midominio.com
COOKIE_DOMAIN=
# En dev false porque localhost es http. En produccion SIEMPRE true.
COOKIE_SECURE=false

# CORS ---------------------------------------------------------------------
# Lista separada por comas. Nunca usar "*" (incompatible con credenciales).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Moneda -------------------------------------------------------------------
DEFAULT_BASE_CURRENCY=COP

# IA (Fase 5) --------------------------------------------------------------
# Si faltan, los modulos de IA se degradan a 503 y el resto de la app sigue.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Entorno ------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
